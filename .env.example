# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shared fallback Groq key. A dedicated agent key below overrides this value.
GROQ_API_KEY=
# Use separate Groq keys to isolate rate limits and increase concurrent agent throughput.
GROQ_DIAGNOSER_API_KEY=
GROQ_GENERATOR_API_KEY=
GROQ_EXPLAINER_API_KEY=
GROQ_ROADMAP_API_KEY=
# Reserved for document/image analysis added to your upload-review workflow.
GROQ_DOCUMENT_API_KEY=
# Vision model used only for image uploads. It supports screenshot/document analysis.
GROQ_DOCUMENT_MODEL="qwen/qwen3.8-27b"
# Optional Groq model override. The default is the supported GPT-OSS 120B model.
GROQ_MODEL="openai/gpt-oss-120b"

# SUPABASE_URL & KEYS: (Optional) For persistent Supabase integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred current Supabase server key (sb_secret_...). Keep it server-only.
SUPABASE_SECRET_KEY=
# Legacy service-role key name; supported for existing Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=

# DUCKDUCKGO_API_ENDPOINT
DUCKDUCKGO_API_ENDPOINT="https://api.duckduckgo.com/"
