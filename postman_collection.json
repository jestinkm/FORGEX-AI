{
  "info": {
    "name": "High-Concurrency Flash-Sale Ticket Booking API",
    "description": "Comprehensive Postman API collection for testing Virtual Waiting Room, Rate Limiting, Optimistic Locking, and Idempotent Payments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "admissionToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer1@ticketflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer1@ticketflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Captcha & Anti-Bot",
      "item": [
        {
          "name": "Get Captcha Challenge",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/captcha/challenge", "host": ["{{baseUrl}}"], "path": ["api", "captcha", "challenge"] }
          }
        },
        {
          "name": "Verify Captcha",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"captchaId\": \"test-captcha\",\n  \"solution\": \"BYPASS_FOR_TESTING\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/captcha/verify", "host": ["{{baseUrl}}"], "path": ["api", "captcha", "verify"] }
          }
        }
      ]
    },
    {
      "name": "3. Events",
      "item": [
        {
          "name": "List Active Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Get Event By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Virtual Waiting Room",
      "item": [
        {
          "name": "Join Queue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.admissionToken) {",
                  "    pm.collectionVariables.set('admissionToken', jsonData.data.admissionToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"captchaToken\": \"BYPASS_TOKEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/queue/join/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "queue", "join", "{{eventId}}"] }
          }
        },
        {
          "name": "Get Queue Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.admissionToken) {",
                  "    pm.collectionVariables.set('admissionToken', jsonData.data.admissionToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/queue/status/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "queue", "status", "{{eventId}}"] }
          }
        },
        {
          "name": "Leave Queue",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/queue/leave/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "queue", "leave", "{{eventId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Orders & Inventory",
      "item": [
        {
          "name": "Hold Tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.orderId) {",
                  "    pm.collectionVariables.set('orderId', jsonData.data.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "X-Admission-Token", "value": "{{admissionToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"ticketCount\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/hold", "host": ["{{baseUrl}}"], "path": ["api", "orders", "hold"] }
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "X-Admission-Token", "value": "{{admissionToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentId\": \"{{paymentId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/confirm", "host": ["{{baseUrl}}"], "path": ["api", "orders", "confirm"] }
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          }
        }
      ]
    },
    {
      "name": "6. Payments",
      "item": [
        {
          "name": "Process Payment (Idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.paymentId) {",
                  "    pm.collectionVariables.set('paymentId', jsonData.data.paymentId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "X-Admission-Token", "value": "{{admissionToken}}" },
              { "key": "Idempotency-Key", "value": "demo-unique-key-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/process", "host": ["{{baseUrl}}"], "path": ["api", "payments", "process"] }
          }
        },
        {
          "name": "Payment Webhook Callback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"status\": \"SUCCESS\",\n  \"signature\": \"sig_mock_12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/webhook", "host": ["{{baseUrl}}"], "path": ["api", "payments", "webhook"] }
          }
        }
      ]
    },
    {
      "name": "7. Admin & Observability",
      "item": [
        {
          "name": "Get Queue Depth",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/queue-depth/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "queue-depth", "{{eventId}}"] }
          }
        },
        {
          "name": "Get Live Inventory",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/inventory/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "inventory", "{{eventId}}"] }
          }
        },
        {
          "name": "Actuator Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/prometheus", "host": ["{{baseUrl}}"], "path": ["actuator", "prometheus"] }
          }
        }
      ]
    }
  ]
}
